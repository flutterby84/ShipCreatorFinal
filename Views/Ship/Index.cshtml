@model IEnumerable<ShipCreator1.Models.Ship>

@{
    ViewData["Title"] = "Home Page";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.ShipName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ShipType)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.NauticalMilage)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PledgedFaction)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.ShipName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ShipType)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.NauticalMilage)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.PledgedFaction)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.ShipID">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.ShipID">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.ShipID">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
